From 394bf92aafdb7bfc144aee6ce824b74a1c0c3ffd Mon Sep 17 00:00:00 2001
From: Angel Salinas <85708983+AngelSalinasT@users.noreply.github.com>
Date: Sun, 4 Oct 2026 23:51:11 -0600
Subject: [PATCH 3/3] p8080: acelerometro con direction 6 (valor leido del
 kernel de fabrica; con 7 la pantalla gira 180 grados)

---
 arch/arm/mach-mt8127/ttab/accelerometer/cust_acc.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/mach-mt8127/ttab/accelerometer/cust_acc.c b/arch/arm/mach-mt8127/ttab/accelerometer/cust_acc.c
index 88d72fb66f6..273cdc937d7 100644
--- a/arch/arm/mach-mt8127/ttab/accelerometer/cust_acc.c
+++ b/arch/arm/mach-mt8127/ttab/accelerometer/cust_acc.c
@@ -6,7 +6,7 @@
 /*---------------------------------------------------------------------------*/
 static struct acc_hw cust_acc_hw = {
     .i2c_num = 2,
-    .direction = 7,
+    .direction = 6, /* p8080: valor del kernel de fabrica de la 8080 (la Puls usa 7) */
     .power_id = MT65XX_POWER_NONE,  /*!< LDO is not used */
     .power_vol= VOL_DEFAULT,        /*!< LDO is not used */
     .firlen = 0, //old value 16                /*!< don't enable low pass fileter */
-- 
